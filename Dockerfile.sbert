FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends gcc g++ curl && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-base.txt requirements-service.txt requirements-training.txt ./
RUN pip install --no-cache-dir \
    -r requirements-service.txt \
    -r requirements-training.txt \
    huggingface_hub

COPY src/ ./src/
RUN touch ./src/__init__.py

RUN python -c "\
from huggingface_hub import snapshot_download; \
snapshot_download( \
    repo_id='JSebastianIEU/tiktok-repo', \
    repo_type='model', \
    local_dir='.', \
    allow_patterns=['artifacts/hashtag_recommender/**'] \
)"

RUN python -c "\
from sentence_transformers import SentenceTransformer; \
SentenceTransformer('all-MiniLM-L6-v2'); \
print('SBERT model cached')"

ENV HASHTAG_RECOMMENDER_DIR=artifacts/hashtag_recommender
ENV ALLOW_MODEL_DOWNLOADS=false
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PORT=8080
ENV PRELOAD_SBERT=true

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD python -c "import urllib.request,json; d=json.loads(urllib.request.urlopen('http://127.0.0.1:8080/v1/health').read()); exit(0 if d.get('ok') else 1)"

CMD ["sh", "-c", "uvicorn src.recommendation.sbert_service:app --host 0.0.0.0 --port ${PORT:-8080}"]
