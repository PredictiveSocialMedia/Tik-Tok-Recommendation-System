{
  "installCommand": "npm install && cd frontend && npm install",
  "buildCommand": "npx vite build --root frontend --outDir dist",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/*.ts": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    {
      "source": "/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/generate-report",
      "destination": "/api/generate-report"
    },
    {
      "source": "/upload-video",
      "destination": "/api/upload-video"
    },
    {
      "source": "/hashtags/suggest",
      "destination": "/api/hashtags-suggest"
    },
    {
      "source": "/suggest-description",
      "destination": "/api/suggest-description"
    }
  ]
}
