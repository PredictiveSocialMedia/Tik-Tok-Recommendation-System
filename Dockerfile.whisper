FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg gcc g++ curl && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-base.txt requirements-service.txt ./
RUN pip install --no-cache-dir \
    -r requirements-service.txt \
    "faster-whisper>=1.0"

COPY src/ ./src/
RUN touch ./src/__init__.py

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PORT=8080
ENV WHISPER_MODEL_SIZE=base
ENV VIDEO_ANALYZER_DEVICE=cpu
ENV PRELOAD_WHISPER=true

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
  CMD python -c "import urllib.request,json; d=json.loads(urllib.request.urlopen('http://127.0.0.1:8080/v1/health').read()); exit(0 if d.get('ok') else 1)"

CMD ["sh", "-c", "uvicorn src.recommendation.video.whisper_service:app --host 0.0.0.0 --port ${PORT:-8080}"]
